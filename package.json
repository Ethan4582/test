{
  "name": "taskflow",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Task automation service with typed domain services and a REST API.",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}